[Unit]
Description=Kino za 5 minut — Telegram publisher (24/7)
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify: процесс сообщает READY=1, когда цикл готов. Нужен для watchdog.
Type=notify
User=kino
WorkingDirectory=/opt/kino/project
EnvironmentFile=/opt/kino/project/.env
ExecStart=/opt/kino/project/venv/bin/python -m kino serve
Restart=always
RestartSec=30
# Watchdog: serve пингует WATCHDOG=1 на каждом тике (tick_seconds=60).
# 180с = три тика запаса: один пропущенный тик не повод для рестарта,
# зависание в сетевом вызове — повод.
WatchdogSec=180
# Мягкая остановка: serve доигрывает текущий пост и выходит.
# 300с — бюджет одного прогона (run.deadline_seconds) плюс запас.
KillSignal=SIGTERM
TimeoutStopSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
