[Unit]
Description=Kino dispatcher — боты клиентов (Ruch) + serve-цикл автопостинга
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kino
Group=kino
WorkingDirectory=/opt/kino/project
EnvironmentFile=/opt/kino/.env
ExecStart=/opt/kino/project/venv/bin/python -m pro_code.main
Restart=always
RestartSec=30
# Мягкая остановка: диспетчер закрывает соединения БД (close_all) и выходит.
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
# Диспетчеру нужны запись в data/ и сеть к api.telegram.org — не больше.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
