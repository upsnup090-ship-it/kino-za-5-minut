# Мастер (вы)
ADMIN_CHAT_ID=123456789

# Боты клиентов: CLIENT_<user_id>=<token из BotFather>
# Пример:
CLIENT_111111111=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
CLIENT_222222222=0987654321:ZYXwvutsrqponMLKJihgfeDCBA

# План клиента (free / auto)
# Если не указан — free
# CLIENT_111111111_PLAN=auto

# Канал клиента для автопостинга (только для плана auto)
# Если не указан — автопостинг не запустится
# CLIENT_111111111_CHANNEL=-1001234567890
