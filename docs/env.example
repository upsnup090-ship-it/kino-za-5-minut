# Шаблон .env. Сам файл .env* в git не коммитится (см. .gitignore), поэтому
# шаблон живёт здесь, а не в корне. Копировать так:
#     cp docs/env.example .env
#
# Значения ниже — плейсхолдеры и комментарии, реальные ключи только в .env.

# Telegram
BOT_TOKEN=***
CHANNEL_CHAT_ID=replace_me
ADMIN_CHAT_ID=replace_me
# Только для Telegram: http://user:pass@host:port или socks5://...
# PROXY_URL=replace_me

# Статьи (вариация article) — graph.org, открывается в Telegram как Instant View.
# Токен создаётся автоматически и кладётся в data/graph_token.txt; задавай,
# только если хочешь использовать готовый аккаунт.
# GRAPH_TOKEN=***
# api.graph.org напрямую из этой сети не отвечает — нужен прокси.
# Пусто = взять LLM_PROXY_URL, затем PROXY_URL.
# GRAPH_PROXY_URL=replace_me

# LLM-провайдер: apimart | gemini | groq | openrouter | openai (env перекрывает YAML)
LLM_PROVIDER=apimart
LLM_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=***
# Из таблицы APIMart — дешёвые модели с оценкой 3/3.
DRAFT_MODEL=glm-5.3-flash
JUDGE_MODEL=deepseek-v4-flash
# Вторая модель судьи, если основная отбилась (5xx, мусор). Пусто — фолбэка нет.
# JUDGE_FALLBACK_MODEL=glm-5.3-flash

# Прокси для LLM-запросов. Пусто = взять PROXY_URL; не задан — напрямую.
# LLM_PROXY_URL=replace_me

# Другие провайдеры (раскомментировать нужное)
# LLM_PROVIDER=groq
# GROQ_API_KEY=***
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=***
# LLM_PROVIDER=openai
# OPENAI_API_KEY=***
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=***

# Источник новостей: rss (фиды из config/sources.yaml) | horizon (LLM-дайджест)
# SOURCE_MODE=rss
# HORIZON_DIR=horizon
# HORIZON_SUMMARIES_DIR=data/summaries

# Состояние, статистика форматов и кэш фидов
# STATE_PATH=data/state.json
# STATS_PATH=logs/format_stats.csv
# FEED_CACHE_DIR=data/feed_cache

# ВНИМАНИЕ: часовой пояс и уровень логов читаются ТОЛЬКО из
# config/settings.yaml (schedule.timezone, logging.level) — из окружения
# не перекрываются. Переменных TZ и LOG_LEVEL в коде нет.
