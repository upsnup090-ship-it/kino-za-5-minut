# --- корень workspace: в git идёт только проект и служебное ---
# секреты
.env*
!.env.example
# окружения и кэши
venv/
__pycache__/
*.pyc
# не-код артефакты и бэкапы
*.zip
*.patch
*.sock
# служебные каталоги агента (не код)
_baseline/
_work/
_agent_log.md
# логи/данные проектов по умолчанию
logs/
data/*.db*
data/*.json
data/feed_cache/
