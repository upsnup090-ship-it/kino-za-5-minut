# ============================================================================
#  БОЕВОЙ КОНФИГ — Киномодули / Ruch
#
#  Куда класть:  /workspace/.env   (рядом с pro_code/, project_ruch/, rrA/)
#  Как начать:   cp .env.example .env   →  заполнить  →  chmod 600 .env
#
#  Файл .env закрыт .gitignore (.env*) — в репозиторий не попадает.
#  Этот шаблон (.env.example) — единственное исключение, он в git идёт.
#
#  Запуск диспетчера:   cd /workspace && python3 -m pro_code.main
#  Запуск автопостинга: cd /workspace/project && python3 -m kino run
#
#  ВАЖНО: значения ниже — плейсхолдеры. Реальные ключи только в .env.
# ============================================================================


# ============================================================================
#  1. ДИСПЕТЧЕР БОТОВ (pro_code)
#
#  Два способа завести клиента:
#    A) главный бот — клиент жмёт /start, вставляет токен, бот поднимается сам
#    B) вручную — строка CLIENT_<user_id>=<token> ниже
#  Оба работают одновременно. Если клиент есть в обоих, побеждает БД (A).
# ============================================================================

# --- Мастер (владелец) ------------------------------------------------------
# Твой Telegram user_id. Только этот id видит RootA, бэкап, логи, LLM-расход.
# Узнать свой id: написать @userinfobot.
# ОБЯЗАТЕЛЬНО. Без него диспетчер не стартует (ConfigError).
ADMIN_CHAT_ID=123456789

# --- Главный бот (модель A) -------------------------------------------------
# Бот мастера. Через него клиенты активируют своих ботов:
#   клиент → /start главному → вставляет токен из @BotFather → бот поднимается
# Токен берётся у @BotFather (/newbot). Необязателен: без него работает
# только ручной способ (B).
MASTER_BOT_TOKEN=1234567890:MASTERbotTOKENhere

# --- Ключ шифрования токенов клиентов ---------------------------------------
# Токены клиентских ботов лежат в clients.db зашифрованными (Fernet:
# AES-128-CBC + HMAC-SHA256). Ключ — только здесь, отдельно от БД.
#
# Сгенерировать ОДИН раз:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ВАЖНО: потеря ключа = потеря всех токенов, клиенты вставляют заново.
# Копию ключа храни отдельно от копии БД, иначе шифрование бесполезно.
# Без ключа диспетчер стартует, но клиентские боты из БД не поднимутся.
TOKEN_ENCRYPTION_KEY=REPLACE_ME_44_chars_base64

# --- Боты клиентов вручную (модель B) ---------------------------------------
# Формат:  CLIENT_<user_id>=<токен из @BotFather>
#   <user_id> — Telegram ID КЛИЕНТА (не бота!), токен — строка 1234567890:AAH...
# Один клиент = один бот = одна строка.
# CLIENT_111111111=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# CLIENT_222222222=0987654321:ZYXwvutsrqponMLKJihgfeDCBA

# --- План клиента -----------------------------------------------------------
# Формат:  CLIENT_<user_id>_PLAN=free|auto
#   free — повторяющиеся сообщения, ручной постинг, статистика, инфо
#   auto — всё из free + автопостинг с LLM (лимит $1 на клиента)
# Не указан или мусор → free.
# CLIENT_111111111_PLAN=auto
# CLIENT_222222222_PLAN=free


# ============================================================================
#  2. РУЧНОЙ МОДУЛЬ (project_ruch)
#     Читает: project_ruch/config.py
# ============================================================================

# Часовой пояс расписаний ручного модуля: время, дни недели, даты
# повторяющихся сообщений считаются в нём, а не в UTC.
# Неизвестная зона → предупреждение в лог + Europe/Moscow (диспетчер не падает).
# RUCH_TIMEZONE=Europe/Moscow


# ============================================================================
#  3. АВТОПОСТИНГ (project/kino) — только для клиентов с планом auto
#     Читает: project/kino/config.py
#
#  ВНИМАНИЕ: kino читает .env из СВОЕГО каталога — project/.env, а не этот.
#  Переменные ниже продублированы здесь для полноты картины. Если запускаешь
#  автопостинг отдельно (python3 -m kino run из project/), заполняй
#  project/.env. Если диспетчер поднимает автопостинг сам — значения берутся
#  из окружения процесса, то есть из этого файла.
# ============================================================================

# --- Telegram (свой бот автопостинга, отдельный от клиентских) --------------
# BOT_TOKEN=***:AAH...
# CHANNEL_CHAT_ID=-1001234567890
# ADMIN_CHAT_ID=123456789

# --- Прокси для Telegram ----------------------------------------------------
# Только для api.telegram.org: http://user:pass@host:port или socks5://...
# PROXY_URL=replace_me

# --- Статьи (вариация article) — graph.org, Instant View --------------------
# Токен создаётся автоматически и кладётся в data/graph_token.txt.
# Задавай, только если хочешь использовать готовый аккаунт.
# GRAPH_TOKEN=***
# api.graph.org напрямую из этой сети не отвечает — нужен прокси.
# Пусто = взять LLM_PROXY_URL, затем PROXY_URL.
# GRAPH_PROXY_URL=replace_me

# --- LLM-провайдер ----------------------------------------------------------
# apimart | gemini | groq | openrouter | openai
# env перекрывает config/settings.yaml
LLM_PROVIDER=apimart
LLM_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=***

# Модели. gemini-3.8-flash — не reasoning-модель: бюджет уходит на JSON,
# а не на скрытые «мысли» (glm-5.3-flash резал черновик из-за reasoning).
DRAFT_MODEL=gemini-3.8-flash
JUDGE_MODEL=deepseek-v4-flash
# Вторая модель судьи, если основная отбилась (5xx, мусор). Пусто — фолбэка нет.
# JUDGE_FALLBACK_MODEL=glm-5.3-flash

# --- Прокси для LLM-запросов ------------------------------------------------
# Пусто = взять PROXY_URL; не задан — напрямую.
# LLM_PROXY_URL=replace_me

# --- Другие провайдеры (раскомментировать нужное) ---------------------------
# LLM_PROVIDER=groq
# GROQ_API_KEY=***
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=***
# LLM_PROVIDER=openai
# OPENAI_API_KEY=***
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=***

# --- Источник новостей ------------------------------------------------------
# rss     — фиды из config/sources.yaml
# horizon — LLM-дайджест из клона Horizon
# SOURCE_MODE=rss
# HORIZON_DIR=horizon
# HORIZON_SUMMARIES_DIR=data/summaries

# --- Состояние, статистика форматов, кэш фидов ------------------------------
# STATE_PATH — состояние пайплайна: что уже опубликовано, хеши, история
#   франшиз. Относительный путь считается от project/.
# STATS_PATH — статистика форматов (CSV).
# FEED_CACHE_DIR — кэш фидов. При 429 источник берётся из последнего удачного
#   снимка, иначе источники с жёстким лимитом (Reddit) теряются на каждом
#   прогоне.
# KINO_DB_PATH — БД автопостинга: слоты, резерв, прогоны.
# STATE_PATH=data/state.json
# STATS_PATH=logs/format_stats.csv
# FEED_CACHE_DIR=data/feed_cache
# KINO_DB_PATH=data/kino.db


# ============================================================================
#  4. ЧАСОВОЙ ПОЯС И ЛОГИ — НЕ ЧЕРЕЗ ENV
#
#  Эти две настройки код из окружения НЕ читает. Переменные TZ и LOG_LEVEL
#  в коде отсутствуют — раскомментировать их бесполезно, они ни на что не
#  влияют. Правится только YAML:
#
#    project/config/settings.yaml
#      schedule.timezone: "Europe/Moscow"     ← часовой пояс автопостинга
#      logging.level: INFO                    ← DEBUG для отладки
#      logging.file: logs/kino.log
#      logging.max_bytes: 5242880
#      logging.backup_count: 5
#      logging.console: true
#      logging.retention_days: 14
#
#  Часовой пояс РУЧНОГО модуля — отдельно, через RUCH_TIMEZONE (раздел 2).
#
#  TZ=Europe/Moscow        ← НЕ РАБОТАЕТ, оставлено для наглядности
#  LOG_LEVEL=INFO          ← НЕ РАБОТАЕТ, оставлено для наглядности
# ============================================================================


# ============================================================================
#  5. ПРОВЕРКА ПЕРЕД ЗАПУСКОМ
#
#  # конфиг читается, токены на месте
#  python3 -c "from pro_code.config import load_config; c = load_config(); \
#              print('admin:', c.admin_chat_id, 'клиентов:', len(c.clients))"
#
#  # тесты ручного модуля
#  python3 -m pytest project_ruch/tests -q
#
#  # синтаксис всех модулей
#  python3 -m compileall -q pro_code project_ruch rrA info rezerv_post
#
#  # права на файл с секретами
#  chmod 600 .env
# ============================================================================
